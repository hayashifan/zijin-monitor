# 紫金单股监控器 - 环境变量配置示例
# 复制此文件为 .env 并修改

# ── 部署模式 ──────────────────────────────────────
# local: 本地开发（默认）
# docker: Docker 容器部署
DEPLOY_MODE=local

# ── 服务配置 ──────────────────────────────────────
PORT=3002
CORS_ORIGIN=http://localhost:5174

# ── 数据库 ────────────────────────────────────────
# Docker 环境下使用绝对路径: /data/zijin_monitor.db
# 本地环境使用相对路径: ../data/zijin_monitor.db
DATABASE_PATH=../data/zijin_monitor.db

# ── API 配置 ──────────────────────────────────────
SINA_API_TIMEOUT=10
CACHE_TTL_SECONDS=300

# ── 股票配置 ──────────────────────────────────────
# 默认监控股票代码（用于 API 默认参数）
DEFAULT_STOCK=601899

# 兼容旧配置（已被 STOCK_REGISTRY 替代）
STOCK_CODES=A:601899,HK:02899

# ── 量化数据 ──────────────────────────────────────
# zijin-quant 输出目录
QUANT_DATA_PATH=~/zijin-quant/data

# ── 代理配置 ──────────────────────────────────────
# Docker 环境下自动禁用，本地环境可选
BYPASS_SYSTEM_PROXY=true

# ── LLM API（可选）────────────────────────────────
# MiMo API（财报 LLM 摘要用）
# MIMO_API_KEY=your-mimo-api-key-here
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek API（年报深度解析用）
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-pro
