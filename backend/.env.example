# 紫金单股监控器 - 环境变量配置示例
# 复制此文件为 .env 并修改

# 服务端口
PORT=3002

# 数据库路径（相对于 backend/ 目录）
DATABASE_PATH=../data/zijin_monitor.db

# CORS 允许的来源
CORS_ORIGIN=http://localhost:5174

# 新浪 API 超时（秒）
SINA_API_TIMEOUT=10

# 缓存 TTL（秒）
CACHE_TTL_SECONDS=300

# 监控股票代码
STOCK_CODES=A:601899,HK:02899

# 是否绕过系统代理
BYPASS_SYSTEM_PROXY=true
